# Auto detect text files and normalize line endings
* text=auto eol=lf

# Text files
*.html text
*.css text
*.js text
*.json text
*.md text
*.txt text
*.xml text
*.svg text

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
*.pdf binary
